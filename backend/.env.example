# ===================================
# Chat AZAC Backend - Environment Variables
# ===================================
# Copy this file to .env and fill in your values
# Do NOT commit .env to version control

# ===== Database Configuration =====
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://chat_user:password123@localhost:5432/chat_azac

# ===== Server Configuration =====
# Port where the server will listen
PORT=3100

# Environment (development, production, test)
NODE_ENV=development

# ===== JWT Configuration =====
# Secret key for JWT token signing (use a strong, random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT expiration time (e.g., 1d, 24h, 7d, etc.)
JWT_EXPIRES_IN=1d

# ===== Email/SMTP Configuration =====
# SMTP server hostname
MAIL_HOST=smtp.gmail.com

# SMTP server port
MAIL_PORT=587

# SMTP authentication username/email
MAIL_USER=your_email@gmail.com

# SMTP authentication password (use app-specific passwords for Gmail)
MAIL_PASS=your_app_password

# From email address for sending emails
MAIL_FROM=noreply@chatazac.com

# ===== Application URLs =====
# Backend application URL
APP_URL=http://localhost:3100

# Frontend/Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ===== Logging (Optional) =====
# Log level (error, warn, info, debug, verbose)
LOG_LEVEL=debug

# ===== Cache (Optional) =====
# Redis connection URL (if using Redis for caching)
# REDIS_URL=redis://localhost:6379

# ===== Rate Limiting (Optional) =====
# Max requests per 15 minutes
RATE_LIMIT_MAX=100
